# Copy to .env and fill in. .env is git-ignored and never served (dotfile-blocked).

# REQUIRED: random secret that signs session cookies. Login + save are DISABLED until set.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CMS_SESSION_SECRET=

# Port for the server (default 3000).
PORT=3000

# Set in production so the session cookie is always marked Secure.
# NODE_ENV=production

# Optional: override where live data lives (default ../enviowebsite-cms-data, OUTSIDE the web root).
# CMS_DATA_DIR=/var/lib/enviowebsite-cms-data
# CMS_CONTENT_FILE=

# Optional first-run admin (used ONLY when no users exist yet). Remove after first login.
# CMS_BOOTSTRAP_USER=admin
# CMS_BOOTSTRAP_PASSWORD=change-me-min-8-chars

# Behind a reverse proxy that terminates TLS: trust X-Forwarded-* headers.
# CMS_TRUST_PROXY=1
# On plain-HTTP local dev the Secure cookie flag is dropped automatically; set to 0 to force it off.
# CMS_SECURE_COOKIE=1
